{% comment %}Runtime for About, Publications, and 404.{% endcomment %}
<script>window.alFolio = { compatBootstrap: false };</script>
<script src="{{ '/assets/js/nav-toggle.js' | relative_url | bust_file_cache }}"></script>

{% if page.selected_papers or page.permalink == '/publications/' %}
  <script defer src="{{ '/assets/js/publications.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

{% if page.selected_papers and site.plugins contains 'al_img_tools' %}
  {% include plugins/al_img_tools_scripts.liquid %}
{% endif %}
{% if site.enable_progressbar %}
  <script defer src="{{ '/assets/js/progress-bar.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
{% if site.back_to_top %}
  {% assign back_to_top = site.third_party_libraries['vanilla-back-to-top'] %}
  <script src="{{ back_to_top.url.js }}" integrity="{{ back_to_top.integrity.js }}" crossorigin="anonymous"></script>
  <script>addBackToTop();</script>
{% endif %}
{% if site.search_enabled and site.plugins contains 'al_search' %}
  {% include plugins/al_search_assets.liquid %}
{% endif %}
