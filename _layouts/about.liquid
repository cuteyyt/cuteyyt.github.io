---
layout: default
---
<div class="post about-page">
  <header class="post-header">
    <h1 class="post-title">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    <div class="about-intro">
      <div class="about-copy">
        {{ content }}
        {% if page.announcements.enabled %}
          <h2>News</h2>
          {% include news.liquid %}
        {% endif %}
      </div>
      {% if page.profile %}
        <aside class="profile">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class="img-fluid z-depth-1 rounded"
            sizes="240px" alt=page.profile.image_alt width=page.profile.image_width height=page.profile.image_height
            cache_bust=true
          %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </aside>
      {% endif %}
    </div>

    {% if page.selected_papers %}
      <h2><a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a></h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
